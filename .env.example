# Vacío en dev: /api y /media vía proxy de Vite
VITE_API_URL=

# Target del proxy en dev (puerto del backend: make run → ver URL en consola)
VITE_DEV_API_TARGET=http://127.0.0.1:5214

# Producción (ejemplo): URL pública del API sin barra final
# VITE_API_URL=https://api.tudominio.com

# Analytics opcional (Plausible) — dominio del sitio
# VITE_ANALYTICS_DOMAIN=fmc-demo.example.com
